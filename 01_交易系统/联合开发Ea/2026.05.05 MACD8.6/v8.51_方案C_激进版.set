; saved on 2026.05.06
; SniperTrendEA v8.51 方案C — 激进版（适合大行情）
; 相比方案A放宽：BodyRatio 0.6→0.5，ConfirmBars 4→3，Shadow 0.20→0.25
; 下单频率更高，信号更多，适合单边趋势市场
; ⚠️ 未经过优化验证，建议先回测确认
;
; ========================================
; 【MACD 参数】
; ========================================
InpFastEMA=12||12||1||12||N
InpSlowEMA=26||26||1||26||N
InpSignalSMA=9||9||1||9||N
;
; ========================================
; 【MA200 趋势过滤】
; ========================================
InpMA200Period=200||200||1||200||N
InpUseMA200Filter=true||true||0||true||N
InpMA200BufferATR=0.45||0.45||0.000000||0.450000||N
;
; ========================================
; 【入场质量过滤】← 激进改动区
; ========================================
InpBodyRatio=0.5||0.5||0.000000||0.500000||N
InpMaxCandleATR=3.0||3.0||0.000000||3.000000||N
InpDangerSuddenRatio=2.0||2.0||0.000000||2.000000||N
InpMaxOppositeShadow=0.25||0.25||0.000000||0.250000||N
InpRequireFollowThrough=false||false||0||false||N
InpFollowThroughBars=3||3||1||3||N
InpConfirmBars=3||3||1||3||N
InpRequireMACDDir=false||false||0||false||N
InpRequireMomentumShift=true||true||0||true||N
;
; ========================================
; 【ADX 趋势过滤】
; ========================================
InpUseADX=false||false||0||false||N
InpADXPeriod=14||14||1||14||N
InpADXThreshold=25.0||25.0||1.0||25.0||N
;
; ========================================
; 【时间过滤】
; ========================================
InpUseTimeFilter=false||false||0||false||N
InpStartHour=8||8||1||8||N
InpEndHour=20||20||1||20||N
;
; ========================================
; 【波动率过滤】
; ========================================
InpUseATRFilter=false||false||0||false||N
InpATRFilterPeriod=20||20||1||20||N
InpATRFilterRatio=1.0||1.0||0.1||1.0||N
;
; ========================================
; 【日线趋势确认】
; ========================================
InpUseDailyFilter=false||false||0||false||N
;
; ========================================
; 【风险管理】
; ========================================
InpRiskPercent=0.5||0.5||0.1||0.5||N
InpATRMultiplier=1.5||1.5||0.1||1.5||N
InpATRPeriod=14||14||1||14||N
InpTrailingStart=5.0||5.0||0.5||5.0||N
InpTrailingStep=2.5||2.5||0.5||2.5||N
InpMaxPositions=1||1||1||1||N
;
; ========================================
