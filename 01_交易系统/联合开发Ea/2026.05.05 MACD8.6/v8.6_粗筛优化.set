; saved on 2026.05.06
; SniperTrendEA v8.6 阶段2 — 入场核心参数优化（防过拟合设计）
; 格式: 参数名=当前值||起始值||步长||结束值||是否优化(Y/N)
; 
; 防过拟合策略:
;   ✅ 阶段1: 出口参数 → BE=OFF, TP=9.0 (PF=2.60, DD=16%) 已锁定
;   → 阶段2: 入场4核心参数(96组合, 2020-2025) → 锁定入场
;   → 阶段3: 最优组合前向验证(2015-2020 数据外验证)
;   → 最终: 全期2015-2025终验
;
; 阶段1结论: BE永远关, TP=9.0是最优, TP>10.5回撤跳回27%
;
; ========================================
; 【MACD 参数】— 锁定
; ========================================
InpFastEMA=12||12||1||12||N
InpSlowEMA=26||26||1||26||N
InpSignalSMA=9||9||1||9||N
;
; ========================================
; 【MA200 趋势过滤】— 锁定
; ========================================
InpMA200Period=200||200||1||200||N
InpUseMA200Filter=true||true||0||true||N
InpMA200BufferATR=0.45||0.45||0.150000||0.450000||N
;
; ========================================
; 【入场质量过滤】— 阶段2核心优化区(4参数 × 96组合)
; ========================================
InpBodyRatio=0.6||0.6||0.050000||0.600000||N
InpMaxCandleATR=3.0||2.0||1.0||4.0||Y
InpDangerSuddenRatio=2.0||1.5||0.5||3.0||Y
InpMaxOppositeShadow=0.20||0.10||0.05||0.25||Y
InpRequireFollowThrough=false||false||0||false||N
InpFollowThroughBars=3||3||1||3||N
InpConfirmBars=4||4||1||4||N
InpRequireMACDDir=false||false||0||false||N
InpRequireMomentumShift=true||false||0||true||Y
;
; ========================================
; 【v8.6 出口参数】— 阶段2锁定(来自阶段1最优)
; ========================================
InpUseBreakeven=false||false||0||false||N
InpBreakevenATR=3.0||3.0||1.000000||3.000000||N
InpTakeProfitATR=9.0||9.0||1.500000||9.000000||N
;
; ========================================
; 【ADX 趋势过滤】— 锁定
; ========================================
InpUseADX=false||false||0||false||N
InpADXPeriod=14||14||1||14||N
InpADXThreshold=25.0||25.0||1.0||25.0||N
;
; ========================================
; 【时间过滤】— 锁定
; ========================================
InpUseTimeFilter=false||false||0||false||N
InpStartHour=8||8||1||8||N
InpEndHour=20||20||1||20||N
;
; ========================================
; 【波动率过滤】— 锁定
; ========================================
InpUseATRFilter=false||false||0||false||N
InpATRFilterPeriod=20||20||1||20||N
InpATRFilterRatio=1.0||1.0||0.1||1.0||N
;
; ========================================
; 【日线趋势确认】— 锁定
; ========================================
InpUseDailyFilter=false||false||0||false||N
;
; ========================================
; 【风险管理】— 锁定
; ========================================
InpRiskPercent=0.5||0.5||0.1||0.5||N
InpATRMultiplier=1.5||1.5||0.1||1.5||N
