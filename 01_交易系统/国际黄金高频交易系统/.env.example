# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=postgres
DB_PASSWORD=your_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 币安API配置
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
BINANCE_TESTNET=True

# MT4配置
MT4_LOGIN=12345
MT4_PASSWORD=your_password
MT4_SERVER=your_server
MT4_TIMEOUT=60000

# DeepSeek AI配置
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 交易配置
RISK_PER_TRADE=0.02
MAX_POSITION_BTC=1.0
MAX_POSITION_ETH=10.0
MAX_POSITION_GOLD=1.0

# 风控配置
MAX_DAILY_LOSS=-1000
MAX_DRAWDOWN=0.1
MAX_TRADES_PER_DAY=100

# 日志配置
LOG_LEVEL=INFO 